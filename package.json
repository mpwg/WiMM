{
  "name": "wimm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "1.4.5"
  },
  "scripts": {
    "dev": "bun --bun run nuxt dev",
    "build": "bun --bun run nuxt build && bun build --target=bun --outfile=tools/manage.mjs tools/manage.ts",
    "start": "bun .output/server/index.mjs",
    "postinstall": "bun --bun run nuxt prepare",
    "typecheck": "bun --bun run nuxt typecheck && bun --bun run tsc -p tsconfig.checks.json",
    "test": "bun test tests/*.test.ts",
    "test:e2e": "bun --bun run playwright test",
    "db:generate": "bun --bun run drizzle-kit generate",
    "db:migrate": "bun tools/manage.ts migrate",
    "db:verify": "bun tools/manage.ts verify"
  },
  "dependencies": {
    "@nuxt/ui": "^4.13.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "nitro": "^3 || ^3.0.261103-rc",
    "nuxt": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.158",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@esbuild-kit/core-utils>esbuild": "^0.28.2",
    "readdir-glob>minimatch": "^11.0.9"
  }
}
