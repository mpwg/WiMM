{
  "name": "wimm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && tsup --config tsup.config.ts",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.checks.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx tools/manage.ts migrate",
    "db:verify": "tsx tools/manage.ts verify"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "nuxt": "4.6.3",
    "nuxt-auth-utils": "0.5.33",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.147",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.11",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
