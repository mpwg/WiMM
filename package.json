{
  "name": "where-is-my-money",
  "version": "0.0.0",
  "private": true,
  "description": "Gemeinsame Grundlage für WhereIsMyMoney.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26.10.0 <28",
    "pnpm": ">=12.8.1 <14"
  },
  "scripts": {
    "build": "pnpm check:rust-toolchain && pnpm -r --if-present build",
    "check:ci": "node scripts/check-ci.mjs",
    "check:docs": "node scripts/check-documentation.mjs",
    "check:package-graph": "node scripts/check-package-graph.mjs",
    "dev:desktop": "pnpm --filter @wimm/desktop dev",
    "dev:server": "pnpm --filter @wimm/server dev",
    "dev:web": "pnpm --filter @wimm/web dev",
    "test": "pnpm test:contracts && pnpm test:domain && pnpm test:crypto && pnpm test:storage && pnpm test:offline && pnpm --filter @wimm/server test && pnpm test:ui-unit && pnpm test:importers",
    "test:contracts": "pnpm --filter @wimm/contracts test",
    "test:crypto": "pnpm --filter @wimm/crypto test",
    "test:domain": "pnpm --filter @wimm/domain test",
    "test:offline": "node --test scripts/service-worker.test.mjs",
    "test:storage": "pnpm --filter @wimm/storage test && vitest run --config vitest.config.ts tests/storage/local-snapshot.test.ts tests/storage/memory-rebuild.test.ts",
    "test:ui": "node scripts/test-ui.mjs",
    "test:docs": "node --test scripts/check-documentation.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "check:rust": "pnpm check:rust-toolchain && pnpm check:rust-format && pnpm lint:rust && pnpm test:rust",
    "check:rust-toolchain": "node scripts/check-rust-toolchain.mjs",
    "check:rust-format": "node scripts/check-rust.mjs fmt",
    "lint:rust": "node scripts/check-rust.mjs clippy",
    "test:rust": "node scripts/check-rust.mjs test",
    "test:ui-unit": "pnpm --filter @wimm/ui test",
    "test:toolchain": "node --test scripts/check-toolchain.test.mjs",
    "check:all": "pnpm check:docs && pnpm test:docs && pnpm test:clean && pnpm check:package-graph && pnpm check:application && pnpm test:package-graph && pnpm typecheck:contracts && pnpm typecheck && pnpm lint && pnpm check:rust && pnpm check:core && pnpm test:toolchain && pnpm test && pnpm test:application && pnpm test:storage:native && pnpm test:storage:migrations && pnpm test:storage:persistence && pnpm test:core:wrapper && pnpm test:core:wasm && pnpm test:ui && pnpm test:ui:integration && pnpm test:ui:matrix && pnpm test:ux && pnpm build && pnpm test:ui:offline && pnpm test:importers:worker",
    "test:ui:build": "node scripts/test-ui.mjs --build",
    "test:ui:offline": "node scripts/test-ui-offline.mjs",
    "test:ui:integration": "pnpm exec playwright test --config tests/workspace/config.ts",
    "test:ui:acceptance": "node scripts/test-ui-acceptance.mjs",
    "test:ui:matrix": "node scripts/test-ui-acceptance.mjs --matrix",
    "test:ui:performance": "node scripts/test-ui-acceptance.mjs --performance",
    "test:ui:zoom": "node scripts/test-ui-acceptance.mjs --zoom",
    "test:importers": "pnpm --filter @wimm/importers test",
    "test:importers:worker": "pnpm exec playwright test --config tests/importers/config.ts",
    "clean": "node scripts/clean.mjs",
    "clean:preview": "node scripts/clean.mjs --all --dry-run",
    "clean:tests": "node scripts/clean.mjs --tests",
    "clean:deps": "node scripts/clean.mjs --deps",
    "clean:all": "node scripts/clean.mjs --all",
    "test:clean": "node --test scripts/clean.test.mjs",
    "test:ux": "pnpm exec playwright test --config tests/ux/config.ts",
    "test:package-graph": "node --test scripts/check-package-graph.test.mjs",
    "test:storage:native": "node scripts/test-storage-native.mjs",
    "typecheck:contracts": "pnpm --filter @wimm/contracts typecheck",
    "check:core": "pnpm check:core:architecture && node scripts/check-core.mjs",
    "test:core:bindings": "node scripts/test-core-bindings.mjs",
    "test:core:wasm": "node scripts/test-core-bindings.mjs --wasm-only",
    "test:core:wrapper": "pnpm --filter @wimm/core-bindings test",
    "check:core:architecture": "node scripts/check-core-architecture.mjs",
    "check:application": "node scripts/check-application.mjs",
    "test:application": "pnpm --filter @wimm/application test",
    "test:storage:migrations": "pnpm exec playwright test --config tests/storage/backups.config.ts && pnpm exec playwright test --config tests/storage/migrations.config.ts",
    "test:storage:persistence": "pnpm exec playwright test --config tests/storage/persistence.config.ts",
    "test:dal:proof": "node scripts/test-dal-proof.mjs"
  },
  "devDependencies": {
    "@babel/parser": "8.0.6",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "markdown-it": "15.0.2",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
