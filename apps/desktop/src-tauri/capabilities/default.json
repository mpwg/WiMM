{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Nur lokale Hauptansicht: Ereignisse, feste Speicherbefehle und dialoggebundene Datei-/Linkports.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-storage-apply-batch",
    "allow-storage-read-aggregate",
    "allow-storage-query-aggregates",
    "allow-storage-load-confirmed",
    "allow-storage-load-pending",
    "allow-storage-get-sync-state",
    "allow-storage-save-sync-page",
    "allow-storage-export-snapshot",
    "allow-storage-replace-snapshot",
    "allow-storage-rebuild-projections",
    "allow-platform-choose-files",
    "allow-platform-write-file",
    "allow-platform-open-url",
    "allow-platform-set-menu"
  ]
}
