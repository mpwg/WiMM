{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "WebWorker"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "packages/browser/dist",
    "rootDir": "packages/browser/src"
  },
  "include": ["packages/browser/src/**/*.ts"]
}
