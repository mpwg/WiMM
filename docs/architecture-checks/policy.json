  "plannedRoles": {
    "client": {
      "allows": "Fachkern, private/lokale Portdaten, Clientkryptoports; keine ORM/UI/HTTP-Runtime"
    },
    "localDal": {
      "allows": "Lokale Datenformen, Persistenzbasis; keine Finanzhandler"
    },
    "clientCrypto": {
      "allows": "Cryptoverträge und native/WASM-libsodium; keine Finanzhandler/ORM/HTTP"
    },
    "server": {
      "allows": "Öffentliche Verträge, Server-DAL, öffentliche Signaturprüfung; kein privater Clientabschluss"
    },
    "serverDal": {
      "allows": "Öffentliche Verträge und echte SQLadapter; keine Finanzmodelle/Privatkrypto"
    },
    "publicCrypto": {
      "allows": "Öffentliche Typen und Signaturprüfung; keine private Clientquelle"
    },
    "http": {
      "allows": "Öffentliche Serveranwendung und Axum/Tokio; eigenes Serverbinary muss geprüft werden"
    }
  },
  "legacyAssertionExemptions": {
    "wimm-ffi-bindgen": "Unveränderter Generatorwrapper im Reviewstand 84d730c; tatsächliche generierte SDKs separat geprüft.",
    "wimm-wasm-glue": "Unveränderter Generatorwrapper im Reviewstand 84d730c; tatsächliche native/WASM-Bindings separat geprüft."
  },
  "plannedServerBinaries": [
    "wimm-server",
    "wimm-http"
  ]
}
