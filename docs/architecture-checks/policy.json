  "rust": {
    "wimm-contract-primitives": {
      "role": "primitive",
      "features": [
        "wasm-data"
      ],
      "checkClosure": true,
      "bindings": true,
      "nativeAssertions": "crates/contract-primitives/src/lib.rs"
    },
    "wimm-public-contracts": {
      "role": "publicTypes",
      "features": [
        "contract-schema",
        "native-bindings",
        "wasm-bindings"
      ],
      "checkClosure": true,
      "bindings": true,
      "nativeAssertions": "crates/public-contracts/tests/forms.rs"
    },
    "wimm-local-contracts": {
      "role": "localTypes",
      "features": [
        "contract-schema",
        "native-bindings",
        "wasm-bindings"
      ],
      "checkClosure": true,
      "bindings": true,
      "nativeAssertions": "crates/local-contracts/tests/storage.rs"
    },
    "wimm-finance-types": {
      "role": "privateTypes",
      "features": [
        "contract-schema",
        "native-bindings",
        "wasm-bindings"
      ],
      "checkClosure": true,
      "bindings": true,
      "nativeAssertions": "crates/finance-types/src/scalars.rs"
    },
    "wimm-finance-core": {
      "role": "core",
      "features": [
        "contract-probe",
        "contract-schema"
      ],
      "checkClosure": true,
      "bindings": false,
      "nativeAssertions": "crates/finance-core/tests/contract_catalog.rs"
    },
    "wimm-core-bindings": {
      "role": "bindings",
      "features": [
        "contract-probe",
        "contract-schema",
        "default",
        "native",
        "wasm"
      ],
      "checkClosure": true,
      "bindings": true,
      "nativeAssertions": "crates/finance-bindings/tests/typed_money.rs"
    },
    "wimm-ffi-bindgen": {
      "role": "generator",
      "features": [],
      "checkClosure": false,
      "bindings": false
    },
    "wimm-core-probe": {
      "role": "probe",
      "features": [],
      "checkClosure": false,
      "bindings": false,
      "nativeAssertions": "tools/core-probe/tests/process_contract.rs"
    },
    "wimm-wasm-glue": {
      "role": "generator",
      "features": [],
      "checkClosure": false,
      "bindings": false
    },
    "wimm-dal-proof": {
      "role": "dalProof",
      "features": [
        "mysql-build",
        "postgres-build"
      ],
      "checkClosure": true,
      "bindings": false,
      "nativeAssertions": "tools/dal-proof/src/lib.rs"
    },
    "wimm-contract-schema": {
      "role": "generator",
      "features": [],
      "checkClosure": false,
      "bindings": false,
      "nativeAssertions": "tools/contract-schema/src/main.rs"
    },
    "wimm-desktop": {
      "role": "platform",
      "features": [],
      "checkClosure": false,
      "bindings": true,
      "nativeAssertions": "apps/desktop/src-tauri/src/storage_failure.rs"
    },
    "wimm-client-crypto": {
      "role": "clientCrypto",
      "features": [
        "contract-probe"
      ],
      "checkClosure": true,
      "bindings": true,
      "nativeAssertions": "crates/client-crypto/src/lib.rs"
    },
    "wimm-public-crypto": {
      "role": "publicCrypto",
      "features": [],
      "checkClosure": true,
      "bindings": false,
      "nativeAssertions": "crates/public-crypto/src/lib.rs"
    }
  },
