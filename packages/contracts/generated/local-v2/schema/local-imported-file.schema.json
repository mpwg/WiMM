{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImportedFile",
  "type": "object",
  "properties": {
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "maximum": 255,
        "minimum": 0
      }
    },
    "mediaType": {
      "type": "string"
    },
    "name": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "bytes"
  ]
}
