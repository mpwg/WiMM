{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransactionIndexQuery",
  "type": "object",
  "properties": {
    "after": {
      "$ref": "#/$defs/TransactionCursor"
    },
    "fromDate": {
      "$ref": "#/$defs/FinanceDate"
    },
    "kind": {
      "$ref": "#/$defs/ReferenceKind"
    },
    "limit": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1000,
      "minimum": 1
    },
    "reference": {
      "type": "string"
    },
    "spaceId": {
      "$ref": "#/$defs/EntityId"
    },
    "throughDate": {
      "$ref": "#/$defs/FinanceDate"
    }
  },
  "additionalProperties": false,
  "required": [
    "spaceId",
    "kind",
    "reference",
    "limit"
  ],
  "$defs": {
    "EntityId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^(?:00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "FinanceDate": {
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "minLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ReferenceKind": {
      "type": "string",
      "enum": [
        "account",
        "category",
        "import"
      ]
    },
    "TransactionCursor": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "#/$defs/FinanceDate"
        },
        "handle": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "additionalProperties": false,
      "required": [
        "date",
        "handle"
      ]
    }
  }
}
