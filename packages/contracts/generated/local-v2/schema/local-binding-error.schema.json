{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalContractError",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "contractVersion": {
          "$ref": "#/$defs/PublicBindingVersion"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "code",
        "detail"
      ]
    }
  ],
  "$defs": {
    "PublicBindingVersion": {
      "type": "integer",
      "const": 2
    }
  }
}
