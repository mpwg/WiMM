{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PendingIndexQuery",
  "type": "object",
  "properties": {
    "limit": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1000,
      "minimum": 1
    },
    "spaceId": {
      "$ref": "#/$defs/EntityId"
    },
    "state": {
      "$ref": "#/$defs/PendingState"
    }
  },
  "additionalProperties": false,
  "required": [
    "spaceId",
    "state",
    "limit"
  ],
  "$defs": {
    "EntityId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^(?:00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "PendingState": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "accepted",
        "conflict",
        "blocked",
        "forbidden",
        "invalid"
      ]
    }
  }
}
