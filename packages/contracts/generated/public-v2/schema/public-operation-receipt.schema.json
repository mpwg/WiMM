{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationReceiptRecord",
  "type": "object",
  "properties": {
    "contentHash": {
      "$ref": "#/$defs/Base64Url"
    },
    "cursor": {
      "type": "string"
    },
    "key": {
      "$ref": "#/$defs/ServerOperationKey"
    }
  },
  "additionalProperties": false,
  "required": [
    "key",
    "contentHash",
    "cursor"
  ],
  "$defs": {
    "Base64Url": {
      "type": "string",
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "PublicId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^(?:00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "ServerOperationKey": {
      "type": "object",
      "properties": {
        "epoch": {
          "$ref": "#/$defs/PublicId"
        },
        "operationId": {
          "$ref": "#/$defs/PublicId"
        },
        "spaceId": {
          "$ref": "#/$defs/PublicId"
        }
      },
      "additionalProperties": false,
      "required": [
        "spaceId",
        "epoch",
        "operationId"
      ]
    }
  }
}
