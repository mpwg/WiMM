{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerOperationKey",
  "type": "object",
  "properties": {
    "epoch": {
      "$ref": "#/$defs/PublicId"
    },
    "operationId": {
      "$ref": "#/$defs/PublicId"
    },
    "spaceId": {
      "$ref": "#/$defs/PublicId"
    }
  },
  "additionalProperties": false,
  "required": [
    "spaceId",
    "epoch",
    "operationId"
  ],
  "$defs": {
    "PublicId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^(?:00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    }
  }
}
