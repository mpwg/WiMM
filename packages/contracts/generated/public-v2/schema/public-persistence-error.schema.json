{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerPersistenceFailure",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "#/$defs/ServerPersistenceCode"
    },
    "contractVersion": {
      "$ref": "#/$defs/PublicBindingVersion"
    }
  },
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "code"
  ],
  "$defs": {
    "PublicBindingVersion": {
      "type": "integer",
      "const": 2
    },
    "ServerPersistenceCode": {
      "type": "string",
      "enum": [
        "REVISION_CONFLICT",
        "QUOTA",
        "WRITE_FAILED",
        "UPDATE_REQUIRED",
        "EPOCH_MISMATCH",
        "OPERATION_ID_REUSED",
        "CANCELLED",
        "RESOURCE_UNAVAILABLE"
      ]
    }
  }
}
