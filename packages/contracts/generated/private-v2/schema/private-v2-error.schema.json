{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractError",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "contractVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 2,
          "minimum": 0
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "code",
        "detail"
      ]
    }
  ]
}
