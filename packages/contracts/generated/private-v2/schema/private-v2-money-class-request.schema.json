{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoneyRequestV2",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "integer",
      "format": "uint32",
      "const": 2,
      "minimum": 0
    },
    "domainSchemaVersion": {
      "type": "integer",
      "format": "uint32",
      "const": 1,
      "minimum": 0
    },
    "spaceId": {
      "$ref": "#/$defs/EntityId"
    },
    "text": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "domainSchemaVersion",
    "spaceId",
    "text"
  ],
  "$defs": {
    "EntityId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^(?:00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    }
  }
}
