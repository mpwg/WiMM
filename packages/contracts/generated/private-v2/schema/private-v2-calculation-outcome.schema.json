{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalculationOutcome",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 2,
          "minimum": 0
        },
        "status": {
          "type": "string",
          "const": "money"
        },
        "value": {
          "$ref": "#/$defs/MoneyCents"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "contractVersion",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "appliedRuleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntityId"
          }
        },
        "candidate": {
          "$ref": "#/$defs/ImportCandidate"
        },
        "contractVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 2,
          "minimum": 0
        },
        "status": {
          "type": "string",
          "const": "ruleApplied"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "contractVersion",
        "candidate",
        "appliedRuleIds"
      ]
    },
    {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 2,
          "minimum": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClassificationRow"
          }
        },
        "status": {
          "type": "string",
          "const": "classified"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "contractVersion",
        "rows"
      ]
    },
    {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "integer",
          "format": "uint32",
          "const": 2,
          "minimum": 0
        },
        "dates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FinanceDate"
          }
        },
        "status": {
          "type": "string",
          "const": "dueDates"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "contractVersion",
        "dates"
      ]
    }
  ],
  "$defs": {
    "Classification": {
      "type": "string",
      "enum": [
        "new",
        "duplicate",
        "conflict"
      ]
    },
    "ClassificationRow": {
      "type": "object",
      "properties": {
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "sourceRow": {
          "$ref": "#/$defs/PositiveOrdinal"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceRow",
        "classification"
      ]
    },
    "EntityId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^(?:00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "FinanceDate": {
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "minLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ImportCandidate": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/MoneyCents"
        },
        "categoryId": {
          "$ref": "#/$defs/EntityId"
        },
        "clearance": {
          "$ref": "#/$defs/ImportClearance"
        },
        "date": {
          "$ref": "#/$defs/FinanceDate"
        },
        "externalId": {
          "type": "string"
        },
        "memo": {
          "type": "string"
        },
        "parserSource": {
          "$ref": "#/$defs/ParserSource"
        },
        "payee": {
          "type": "string"
        },
        "payeeId": {
          "$ref": "#/$defs/EntityId"
        },
        "sourceFingerprint": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "sourceRow": {
          "$ref": "#/$defs/PositiveOrdinal"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceRow",
        "date",
        "amount"
      ]
    },
    "ImportClearance": {
      "type": "string",
      "enum": [
        "uncleared",
        "cleared"
      ]
    },
    "MoneyCents": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991
    },
    "NonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0009\\u000a\\u000b\\u000c\\u000d\\u0020\\u00a0\\u1680\\u2000\\u2001\\u2002\\u2003\\u2004\\u2005\\u2006\\u2007\\u2008\\u2009\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "ParserSource": {
      "type": "string",
      "enum": [
        "csv",
        "camt053",
        "ofx",
        "qfx"
      ]
    },
    "PositiveOrdinal": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    }
  }
}
