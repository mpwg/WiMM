{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegacyRejected",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "integer",
      "format": "uint32",
      "const": 1,
      "minimum": 0
    },
    "error": {
      "$ref": "#/$defs/LegacyError"
    },
    "status": {
      "$ref": "#/$defs/RejectedStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "status",
    "error"
  ],
  "$defs": {
    "LegacyError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "RejectedStatus": {
      "type": "string",
      "enum": [
        "rejected"
      ]
    }
  }
}
