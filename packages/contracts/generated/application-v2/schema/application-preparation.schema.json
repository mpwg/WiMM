{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplicationPreparationV2",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/CommitContext"
        },
        "contractVersion": {
          "$ref": "#/$defs/ApplicationBindingVersion"
        },
        "request": {
          "$ref": "#/$defs/LocalCommitRequest"
        },
        "status": {
          "type": "string",
          "const": "prepared"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "contractVersion",
        "context",
        "request"
      ]
    },
    {
      "type": "object",
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/ApplicationBindingVersion"
        },
        "status": {
          "type": "string",
          "const": "unchanged"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "contractVersion"
      ]
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ApplicationFailureCode"
        },
        "contractVersion": {
          "$ref": "#/$defs/ApplicationBindingVersion"
        },
        "financeCode": {
          "$ref": "#/$defs/RequiredNullableFinanceCode"
        },
        "status": {
          "type": "string",
          "const": "rejected"
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "contractVersion",
        "code",
        "financeCode"
      ]
    }
  ],
  "$defs": {
    "AccountType": {
      "type": "string",
      "enum": [
        "checking",
        "cash",
        "savings",
        "credit",
        "other"
      ]
    },
    "ApplicationBindingVersion": {
      "type": "integer",
      "const": 2
    },
    "ApplicationFailureCode": {
      "type": "string",
      "enum": [
        "UPDATE_REQUIRED",
        "SCOPE_CHANGED",
        "WRONG_AREA",
        "INVALID_STATE",
        "FINANCE_REJECTED"
      ]
    },
    "AtomicBatch": {
      "type": "object",
      "properties": {
        "aggregates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoredAggregate"
          }
        },
        "expectedRevisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionExpectation"
          }
        },
        "outbox": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingOperation"
          }
        },
        "projections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoredProjection"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "expectedRevisions",
        "aggregates",
        "outbox",
        "projections"
      ]
    },
    "BalancePayload": {
      "type": "object",
      "properties": {
        "accountId": {
          "$ref": "#/$defs/EntityId"
        },
        "balance": {
          "$ref": "#/$defs/MoneyCents"
        }
      },
      "additionalProperties": false,
      "required": [
        "balance"
      ]
    },
    "BoundedVec_EntityId_1_unbounded": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EntityId"
      },
      "minItems": 1
    },
    "BoundedVec_ImportRow_1_100000": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportRow"
      },
      "maxItems": 100000,
      "minItems": 1
    },
    "BoundedVec_RuleAction_1_unbounded": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleAction"
      },
      "minItems": 1
    },
    "BoundedVec_RuleCondition_1_unbounded": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleCondition"
      },
      "minItems": 1
    },
    "CategoryConsumption": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/MoneyCents"
        },
        "categoryId": {
          "$ref": "#/$defs/EntityId"
        },
        "groupKind": {
          "$ref": "#/$defs/GroupKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "categoryId",
        "groupKind",
        "amount"
      ]
    },
    "CategorySystem": {
      "type": "string",
      "enum": [
        "uncategorized"
      ]
    },
    "Clearance": {
      "type": "string",
      "enum": [
        "uncleared",
        "cleared",
        "reconciled"
      ]
    },
    "CommitContext": {
      "type": "object",
      "properties": {
        "epoch": {
          "$ref": "#/$defs/EntityId"
        },
        "generation": {
          "$ref": "#/$defs/Revision"
        },
        "profileId": {
          "$ref": "#/$defs/EntityId"
        },
        "profileRevision": {
          "$ref": "#/$defs/Revision"
        },
        "sessionGeneration": {
          "$ref": "#/$defs/Revision"
        },
        "spaceId": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "additionalProperties": false,
      "required": [
        "profileId",
        "spaceId",
        "epoch",
        "profileRevision",
        "sessionGeneration",
        "generation"
      ]
    },
    "ConditionField": {
      "type": "string",
      "enum": [
        "date",
        "amount",
        "payee",
        "memo"
      ]
    },
    "ConditionOperator": {
      "type": "string",
      "enum": [
        "equals",
        "contains",
        "gte",
        "lte"
      ]
    },
    "ConditionValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/MoneyCents"
        }
      ]
    },
    "Consumption": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CategoryConsumption"
          }
        },
        "expense": {
          "$ref": "#/$defs/MoneyCents"
        },
        "income": {
          "$ref": "#/$defs/MoneyCents"
        },
        "net": {
          "$ref": "#/$defs/MoneyCents"
        }
      },
      "additionalProperties": false,
      "required": [
        "income",
        "expense",
        "net",
        "categories"
      ]
    },
    "EntityId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^(?:00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "FileHash": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "FinanceDate": {
      "type": "string",
      "format": "date",
      "maxLength": 10,
      "minLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "yearly"
      ]
    },
    "GroupKind": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ]
    },
    "ImportCandidate": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/MoneyCents"
        },
        "categoryId": {
          "$ref": "#/$defs/EntityId"
        },
        "clearance": {
          "$ref": "#/$defs/ImportClearance"
        },
        "date": {
          "$ref": "#/$defs/FinanceDate"
        },
        "externalId": {
          "type": "string"
        },
        "memo": {
          "type": "string"
        },
        "parserSource": {
          "$ref": "#/$defs/ParserSource"
        },
        "payee": {
          "type": "string"
        },
        "payeeId": {
          "$ref": "#/$defs/EntityId"
        },
        "sourceFingerprint": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "sourceRow": {
          "$ref": "#/$defs/PositiveOrdinal"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceRow",
        "date",
        "amount"
      ]
    },
    "ImportClearance": {
      "type": "string",
      "enum": [
        "uncleared",
        "cleared"
      ]
    },
    "ImportDecision": {
      "type": "string",
      "enum": [
        "import",
        "exclude",
        "separate"
      ]
    },
    "ImportRow": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/RequiredNullableCandidate"
        },
        "decision": {
          "$ref": "#/$defs/ImportDecision"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceRow": {
          "$ref": "#/$defs/PositiveOrdinal"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceRow",
        "candidate",
        "decision",
        "issues"
      ]
    },
    "ImportState": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "completed"
      ]
    },
    "LocalCommitRequest": {
      "type": "object",
      "properties": {
        "batch": {
          "$ref": "#/$defs/AtomicBatch"
        },
        "identity": {
          "$ref": "#/$defs/LocalOperationIdentity"
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "batch"
      ]
    },
    "LocalOperationContractVersion": {
      "type": "integer",
      "const": 1
    },
    "LocalOperationIdentity": {
      "type": "object",
      "properties": {
        "epoch": {
          "$ref": "#/$defs/EntityId"
        },
        "operationContractVersion": {
          "$ref": "#/$defs/LocalOperationContractVersion"
        },
        "operationId": {
          "$ref": "#/$defs/EntityId"
        },
        "profileId": {
          "$ref": "#/$defs/EntityId"
        },
        "spaceId": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "additionalProperties": false,
      "required": [
        "operationContractVersion",
        "profileId",
        "spaceId",
        "epoch",
        "operationId"
      ]
    },
    "MoneyCents": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991
    },
    "NonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\u0009\\u000a\\u000b\\u000c\\u000d\\u0020\\u00a0\\u1680\\u2000\\u2001\\u2002\\u2003\\u2004\\u2005\\u2006\\u2007\\u2008\\u2009\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "OccurrenceState": {
      "type": "string",
      "enum": [
        "confirmed",
        "skipped"
      ]
    },
    "Ordinal": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "ParserSource": {
      "type": "string",
      "enum": [
        "csv",
        "camt053",
        "ofx",
        "qfx"
      ]
    },
    "PendingOperation": {
      "type": "object",
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntityId"
          }
        },
        "draft": true,
        "expectedRevisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionExpectation"
          }
        },
        "operationId": {
          "$ref": "#/$defs/EntityId"
        },
        "retryCount": {
          "$ref": "#/$defs/Ordinal"
        },
        "spaceId": {
          "$ref": "#/$defs/EntityId"
        },
        "state": {
          "$ref": "#/$defs/PendingState"
        }
      },
      "additionalProperties": false,
      "required": [
        "operationId",
        "spaceId",
        "expectedRevisions",
        "dependsOn",
        "state",
        "draft",
        "retryCount"
      ]
    },
    "PendingState": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "accepted",
        "conflict",
        "blocked",
        "forbidden",
        "invalid"
      ]
    },
    "PositiveOrdinal": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "RequiredNullableCandidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImportCandidate"
        },
        {
          "type": "null"
        }
      ]
    },
    "RequiredNullableFinanceCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "Revision": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "RevisionExpectation": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "handle": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "additionalProperties": false,
      "required": [
        "handle",
        "expectedRevision"
      ]
    },
    "RuleAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "categoryId"
            },
            "value": {
              "$ref": "#/$defs/EntityId"
            }
          },
          "additionalProperties": false,
          "required": [
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "payeeId"
            },
            "value": {
              "$ref": "#/$defs/EntityId"
            }
          },
          "additionalProperties": false,
          "required": [
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "const": "clearance"
            },
            "value": {
              "$ref": "#/$defs/ImportClearance"
            }
          },
          "additionalProperties": false,
          "required": [
            "field",
            "value"
          ]
        }
      ]
    },
    "RuleCondition": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/ConditionField"
        },
        "operator": {
          "$ref": "#/$defs/ConditionOperator"
        },
        "value": {
          "$ref": "#/$defs/ConditionValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "operator",
        "value"
      ]
    },
    "Split": {
      "type": "object",
      "properties": {
        "amount": {
          "$ref": "#/$defs/MoneyCents"
        },
        "categoryId": {
          "$ref": "#/$defs/EntityId"
        },
        "id": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "categoryId",
        "amount"
      ]
    },
    "StoredAggregate": {
      "description": "Native Records trennen Handle und Fachaggregat; Serde erhält das flache V1-Format.",
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "aggregateType": {
              "type": "string",
              "const": "account"
            },
            "archived": {
              "type": "boolean"
            },
            "createdAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "deletedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "id": {
              "$ref": "#/$defs/EntityId"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "onBudget": {
              "type": "boolean"
            },
            "revision": {
              "$ref": "#/$defs/StoredRevision"
            },
            "spaceId": {
              "$ref": "#/$defs/EntityId"
            },
            "type": {
              "$ref": "#/$defs/AccountType"
            },
            "updatedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            }
          },
          "required": [
            "aggregateType",
            "id",
            "spaceId",
            "revision",
            "createdAt",
            "updatedAt",
            "name",
            "type",
            "onBudget",
            "archived"
          ]
        },
        {
          "type": "object",
          "properties": {
            "aggregateType": {
              "type": "string",
              "const": "financialRevision"
            },
            "createdAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "deletedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "id": {
              "$ref": "#/$defs/EntityId"
            },
            "revision": {
              "$ref": "#/$defs/StoredRevision"
            },
            "spaceId": {
              "$ref": "#/$defs/EntityId"
            },
            "updatedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            }
          },
          "required": [
            "aggregateType",
            "id",
            "spaceId",
            "revision",
            "createdAt",
            "updatedAt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "aggregateType": {
              "type": "string",
              "const": "categoryGroup"
            },
            "archived": {
              "type": "boolean"
            },
            "createdAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "deletedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "id": {
              "$ref": "#/$defs/EntityId"
            },
            "kind": {
              "$ref": "#/$defs/GroupKind"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "revision": {
              "$ref": "#/$defs/StoredRevision"
            },
            "sortOrder": {
              "$ref": "#/$defs/Ordinal"
            },
            "spaceId": {
              "$ref": "#/$defs/EntityId"
            },
            "updatedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            }
          },
          "required": [
            "aggregateType",
            "id",
            "spaceId",
            "revision",
            "createdAt",
            "updatedAt",
            "name",
            "kind",
            "sortOrder",
            "archived"
          ]
        },
        {
          "type": "object",
          "properties": {
            "aggregateType": {
              "type": "string",
              "const": "category"
            },
            "archived": {
              "type": "boolean"
            },
            "createdAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "deletedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "groupId": {
              "$ref": "#/$defs/EntityId"
            },
            "id": {
              "$ref": "#/$defs/EntityId"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "revision": {
              "$ref": "#/$defs/StoredRevision"
            },
            "sortOrder": {
              "$ref": "#/$defs/Ordinal"
            },
            "spaceId": {
              "$ref": "#/$defs/EntityId"
            },
            "system": {
              "$ref": "#/$defs/CategorySystem"
            },
            "updatedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            }
          },
          "required": [
            "aggregateType",
            "id",
            "spaceId",
            "revision",
            "createdAt",
            "updatedAt",
            "name",
            "groupId",
            "sortOrder",
            "archived"
          ]
        },
        {
          "type": "object",
          "properties": {
            "aggregateType": {
              "type": "string",
              "const": "payee"
            },
            "aliases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NonEmptyText"
              }
            },
            "archived": {
              "type": "boolean"
            },
            "createdAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "deletedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "id": {
              "$ref": "#/$defs/EntityId"
            },
            "name": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "revision": {
              "$ref": "#/$defs/StoredRevision"
            },
            "spaceId": {
              "$ref": "#/$defs/EntityId"
            },
            "updatedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            }
          },
          "required": [
            "aggregateType",
            "id",
            "spaceId",
            "revision",
            "createdAt",
            "updatedAt",
            "name",
            "aliases",
            "archived"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "$ref": "#/$defs/EntityId"
            },
            "aggregateType": {
              "type": "string",
              "const": "transaction"
            },
            "amount": {
              "$ref": "#/$defs/MoneyCents"
            },
            "clearance": {
              "$ref": "#/$defs/Clearance"
            },
            "createdAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "date": {
              "$ref": "#/$defs/FinanceDate"
            },
            "deletedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            },
            "id": {
              "$ref": "#/$defs/EntityId"
            },
            "importReference": {
              "$ref": "#/$defs/NonEmptyText"
            },
            "kind": {
              "$ref": "#/$defs/TransactionKind"
            },
            "note": {
              "type": "string"
            },
            "payeeId": {
              "$ref": "#/$defs/EntityId"
            },
            "revision": {
              "$ref": "#/$defs/StoredRevision"
            },
            "scheduleOccurrenceId": {
              "$ref": "#/$defs/EntityId"
            },
            "spaceId": {
              "$ref": "#/$defs/EntityId"
            },
            "splits": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Split"
              }
            },
            "transferId": {
              "$ref": "#/$defs/EntityId"
            },
            "updatedAt": {
              "$ref": "#/$defs/UtcTimestamp"
            }
          },
          "required": [
            "aggregateType",
            "id",
            "spaceId",
            "revision",
            "createdAt",
            "updatedAt",
            "accountId",
            "amount",
            "kind",
            "clearance",
            "splits",
            "date"
          ]
        },
        {
          "type": "object",
          "properties": {
            "aggregateType": {
              "type": "string",
              "const": "transfer"
